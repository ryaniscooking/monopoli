{
  "name": "monopoli",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test",
    "sim": "tsx scripts/sim.ts",
    "sim:smoke": "tsx scripts/sim.ts --smoke --bots easy,normal,hard,normal",
    "maps:validate": "tsx scripts/maps-validate.ts",
    "board:template": "tsx scripts/board-template.ts",
    "build:engine-edge": "tsx scripts/build-engine-for-edge.ts",
    "sim:targets": "tsx scripts/sim.ts --targets",
    "test:online": "pnpm build:engine-edge && pnpm --filter @monopoli/server test:integration && E2E_ONLINE=1 pnpm --filter web exec playwright test e2e/online.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monopoli/engine": "workspace:*",
    "@monopoli/maps": "workspace:*",
    "@monopoli/server": "workspace:*",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
